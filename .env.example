# Local dev (`bun run dev` / `npm run dev`) always runs on mock data (src/lib/mockDb.ts) —
# Vite doesn't load .env.production for the dev server, so copying these into plain .env
# would switch local dev to the real backend. Don't do that.
#
# To point a PRODUCTION BUILD at a real Supabase project, copy this file to .env.production
# and fill in the values below (find them in Supabase Dashboard → Project Settings → API).
# For the actual Cloudflare Pages deploy, set these as project env vars in the dashboard
# instead (TODO.md §10) rather than relying on a committed/local file.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL of the recommendations service (server/) — the frontend calls POST {URL}/refresh
# from the admin panel. Leave blank until the service is deployed; the "Refresh" button will
# report it's unconfigured. Local dev on mock data never calls it.
VITE_RECS_API_URL=

# --- server/ only (NOT read by the frontend; keep out of any VITE_ file) ---
# These live in the repo-root .env on the box that runs `bun run server`.
#   SUPABASE_URL, SUPABASE_SECRET_KEY   Supabase project + service (secret) key
#   GEMINI_API_KEY                      Google AI Studio key
#   GEMINI_EMBED_MODEL=gemini-embedding-001
#   GEMINI_CHAT_MODEL=gemini-flash-lite-latest
#   EMBED_DIMS=768
#   PORT=8787
#   CRON_SECRET=<strong-secret>         auth for cron/systemd POST /refresh
#   REFRESH_INTERVAL_MS=3600000         optional; hourly full refresh
#   WATCH_INTERVAL_MS=120000            optional; how often to check for new jobs
#   NEW_JOBS_THRESHOLD=5                optional; auto-refresh once this many new jobs pile up
#   RECS_POOL_SIZE=24                  optional; recommendations stored per user (client pages through)

# Web push (VAPID) — generate with: bunx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
VITE_VAPID_PUBLIC_KEY=
