# Local dev (`bun run dev` / `npm run dev`) always runs on mock data (src/lib/mockDb.ts) —
# Vite doesn't load .env.production for the dev server, so copying these into plain .env
# would switch local dev to the real backend. Don't do that.
#
# To point a PRODUCTION BUILD at a real Supabase project, copy this file to .env.production
# and fill in the values below (find them in Supabase Dashboard → Project Settings → API).
# For the actual Cloudflare Pages deploy, set these as project env vars in the dashboard
# instead (TODO.md §10) rather than relying on a committed/local file.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
